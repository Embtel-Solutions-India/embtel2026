{
  "ci": {
    "collect": {
      "startServerCommand": "npx tsx tests/e2e/server.ts",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 600000,
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/web-development",
        "http://localhost:3100/law-industry",
        "http://localhost:3100/dental-automation",
        "http://localhost:3100/about",
        "http://localhost:3100/privacy-policy",
        "http://localhost:3100/blog",
        "http://localhost:3100/blog/website-speed-costing-you-customers"
      ],
      "numberOfRuns": 5,
      "settings": {
        "blockedUrlPatterns": [
          "*elfsight*"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median-run"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
