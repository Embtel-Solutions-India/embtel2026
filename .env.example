# Copy to .env.local for development. Never commit real values; production values live in Vercel.

# Runtime mode: development | production | test
NODE_ENV=development
# Public site origin used for canonical URLs and sitemaps
SITE_URL=https://www.embtelsolutions.com
# MongoDB connection string
MONGODB_URI=<set-in-vercel>
# Session signing secret, at least 32 characters
SESSION_SECRET=<set-in-vercel>
# Encryption key, 32 random bytes, base64-encoded
ENCRYPTION_KEY=<set-in-vercel>
# S3 bucket for media uploads
AWS_S3_BUCKET=<set-in-vercel>
# AWS region of the bucket
AWS_REGION=<set-in-vercel>
# AWS access key ID for S3
AWS_ACCESS_KEY_ID=<set-in-vercel>
# AWS secret access key for S3
AWS_SECRET_ACCESS_KEY=<set-in-vercel>
# Optional: public base URL for uploaded media (e.g. CDN origin)
AWS_S3_PUBLIC_URL_BASE=<set-in-vercel>

# SMTP settings are all optional (email disabled when unset)
# Optional: SMTP server host
SMTP_HOST=<set-in-vercel>
# Optional: SMTP server port
SMTP_PORT=587
# Optional: SMTP username
SMTP_USER=<set-in-vercel>
# Optional: SMTP password
SMTP_PASS=<set-in-vercel>
# Optional: From address for outgoing mail
SMTP_FROM=<set-in-vercel>

# Optional. IndexNow key (8-128 chars, letters/digits/dashes); generate with `openssl rand -hex 16`.
INDEXNOW_KEY=<set-in-vercel>

# Optional. Vercel Cron secret (32+ random chars, e.g. `openssl rand -hex 32`); enables scheduled publishing.
CRON_SECRET=<set-in-vercel>
