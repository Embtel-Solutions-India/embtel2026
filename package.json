  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate-db.ts",
    "admin:create": "tsx --env-file=.env.local scripts/create-admin.ts",
    "content:import": "tsx scripts/import-legacy/index.ts",
    "content:seed": "tsx --env-file=.env.local scripts/seed-content.ts",
    "lhci": "lhci autorun",
    "cutover:parity": "tsx scripts/cutover/parity.ts",
    "cutover:accounts": "tsx --env-file=.env.local scripts/cutover/accounts.ts",
    "cutover:authors": "tsx --env-file=.env.local scripts/cutover/assign-authors.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "mongoose": "^8.24.6",
    "next": "16.4.2",
    "nodemailer": "^10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
